VITE_API_URL=http://localhost:8080
VITE_V2_API_URL=http://localhost:8080
VITE_V3_API_URL=http://localhost:8080
VITE_LOCAL_V3_API_URL=http://127.0.0.1:8080
VITE_RENDER_V3_API_URL=https://smart-backend-v3.onrender.com

# The current V1-only screens still use VITE_API_URL.
# Contract-aligned V2 screens use VITE_V2_API_URL through src/api/apiV2Client.js.
# Keep the V1 and V2 backend addresses separate during local development.

# Render production backend:
# VITE_API_URL=https://smart-backend-v3.onrender.com
# VITE_V2_API_URL=https://your-v2-backend.onrender.com
# VITE_V3_API_URL=https://your-v3-backend.onrender.com

# Backward-compatible legacy variable also supported by src/api/apiClient.js:
# VITE_API_BASE_URL=http://localhost:8080
